# ======================================================================
# QR Kampanya - ortam ayarları ÖRNEĞİ
# Bu dosyayı .env adıyla kopyalayın:  cp .env.example .env
# veya scripts/kurulum.sh betiğini çalıştırın (güçlü parolaları kendisi üretir).
# .env dosyası Git'e EKLENMEZ. Buradaki değerler gerçek değildir.
# ======================================================================

# --- Alan adı (DEĞİŞTİRİN) ---
# QR kodların içine yazılacak alan adınız. Örnek: qr.firmaniz.com
SITE_ALAN_ADI=qr.ornekfirma.com
# Caddy'nin dinleyeceği adres. Üretimde alan adının kendisi (HTTPS otomatik).
# Yerel denemede: http://localhost
SITE_ADRESI=qr.ornekfirma.com
SITE_SEMA=https
DJANGO_ALLOWED_HOSTS=qr.ornekfirma.com
# Let's Encrypt bildirimleri için e-posta (gerçek alan adında ZORUNLU, DEĞİŞTİRİN; boş bırakılırsa Caddy başlamaz).
# Yerel denemede (SITE_ADRESI=http://localhost) kurulum.sh yer tutucu yazar: yerel-deneme@example.com
ACME_EPOSTA=ornek@ornekfirma.com

# --- Gizli değerler (kurulum.sh üretir; elle yazacaksanız uzun ve rastgele olsun) ---
DJANGO_SECRET_KEY=BURAYA-KURULUM-BETIGI-URETECEK-degistir
# POSTGRES_PASSWORD: yalnızca bakım için süper kullanıcı parolası (uygulama onunla bağlanmaz).
POSTGRES_PASSWORD=BURAYA-KURULUM-BETIGI-URETECEK-degistir
# qr_sahip (veritabanı sahibi; migrasyon ve yedek) ve qr_uygulama (web uygulaması, kısıtlı) rol parolaları.
POSTGRES_SAHIP_PAROLA=BURAYA-KURULUM-BETIGI-URETECEK-degistir
POSTGRES_UYGULAMA_PAROLA=BURAYA-KURULUM-BETIGI-URETECEK-degistir

# MFA (iki adımlı doğrulama) gizli anahtarlarını veritabanında şifreleyen anahtar. scripts/kurulum.sh ve scripts/guncelle.sh
# bunu üretip bu dosyanın SONUNA ekler; elle yazmanız gerekmez. Biçim: 32 baytlık urlsafe base64 Fernet anahtarı (44 karakter).
# Birden çok anahtar virgülle ayrılır (anahtar döndürme): İLK anahtar yeni şifrelemede kullanılır, hepsi çözmede denenir.
# Döndürme sırası: yeni anahtarı başa ekleyin -> uygulamayı yeniden başlatın -> `manage.py mfa_sifreyi_yenile` -> eskisini silin.
# UYARI: Bu anahtar kaybolursa MFA kayıtları çözülemez (yönetici `mfa_sifirla` ile kullanıcıyı sıfırlar). .env yedeğini parola
# yöneticisinde saklayın. Veritabanı yedeği tek başına MFA sırlarını açığa çıkarmaz (anahtar .env'dedir, yedekte değil).
# MFA_SIFRELEME_ANAHTARI=

# --- Veritabanı ---
POSTGRES_DB=qrkampanya
POSTGRES_USER=qrkampanya

# --- Güvenlik ---
DJANGO_DEBUG=0
MFA_ZORUNLU=1
GIRIS_DENEME_SINIRI=5
GIRIS_KILIT_SURESI_SN=900
# Hesap başına (IP'den bağımsız) geçici kilit eşiği ve IP başına (kullanıcı adından bağımsız) eşik
HESAP_DENEME_SINIRI=10
IP_DENEME_SINIRI=20
# /panel/giris ve /panel/mfa/* için IP başına dakikadaki en çok POST (0 = kapalı)
GIRIS_HIZ_SINIRI=10
YONLENDIRME_HIZ_SINIRI=120
# İsteğe bağlı ülke bilgisi (GeoIP). MaxMind GeoLite2-Country.mmdb dosyasının KONTEYNER içindeki yolu; docker-compose.yml'de
# dosyayı salt okunur bağlayın (docs/KULLANIM.md "GeoIP ile ülke bilgisi"). Boş = ülke tutulmaz.
GEOIP_VERITABANI=
QR_OLUSTURMA_HIZ_SINIRI=30
# API: anahtar başına dakikada başarılı istek / IP başına dakikada başarısız kimlik doğrulama
API_HIZ_SINIRI=60
API_BASARISIZ_HIZ_SINIRI=10
# Kullanıcı başına ortak dakikalık sınır (varsayılan API_HIZ_SINIRI), kullanıcı başına en çok aktif anahtar, anahtar oluşturma ucu sınırı (dk)
# API_KULLANICI_HIZ_SINIRI=60
API_AZAMI_ANAHTAR=10
# API_ANAHTAR_OLUSTURMA_HIZ_SINIRI=5
# Tarayıcıdan API erişimi için izinli kökenler (virgülle; boş = CORS kapalı; yıldız kabul edilmez)
API_CORS_KOKENLERI=
# İsteğe bağlı panel/API ağ kısıtı: virgülle ayrılmış CIDR listesi (örn. 203.0.113.0/24,2001:db8::/32). Boş = kısıt yok.
# Doluysa /panel/, /api/ ve /admin/ yalnızca bu ağlardan açılır, diğerleri 404 alır; /k/, /l/, /s/, /saglik, /robots.txt, statik
# ve medya etkilenmez. Hatalı değer uygulamayı BAŞLATMAZ. Kendi IP'nizi eklemeden açarsanız panelden kilitlenirsiniz
# (kurtarma: docs/GUVENLIK.md "Panel ve API için IP kısıtı").
YONETIM_IZINLI_AGLAR=
# Eklentiler (docs/EKLENTILER.md): app/eklentiler/ altındaki modüllerden yalnızca adı burada geçenler çalışır (virgüllü, örn. ornek_gunluk).
# Eklenti sunucuda uygulamayla aynı yetkiyle çalışır; yalnızca güvendiğiniz kodu ekleyin. Boş = eklenti yok.
QR_EKLENTILER=
# Sistem bilgisi sayfasında göstermek için (isteğe bağlı): kullandığınız imajın digest'i (sha256:...). Hiçbir yere bağlanılmaz.
# QR_IMAJ_DIGEST=

# --- Ağ ---
# Caddy ile uygulamanın bulunduğu "web" ağının alt ağı (gunicorn yalnızca bu ağdan X-Forwarded-* kabul eder).
# Sunucudaki başka bir ağla çakışırsa değiştirin.
WEB_ALT_AGI=172.28.0.0/16

# --- Veri saklama (KVKK) ---
TARAMA_SAKLAMA_GUN=730

# --- Yedekleme ---
YEDEK_SAATI=03:15
YEDEK_SAKLAMA_GUN=14
YEDEK_DIZINI=./yedekler
# Yedekler age ile şifrelenir. YEDEK_ALICI (açık anahtar, age1...) kurulum.sh tarafından bu dosyanın SONUNA eklenir;
# elle yazmanız gerekmez. Özel anahtar gizli/yedek-anahtari.txt dosyasındadır: parola yöneticinize kopyalayın,
# kaybolursa yedekler açılamaz. Özel anahtar yedek servisine VERİLMEZ.
# YEDEK_ALICI=age1...
# Sunucu dışı kopya (rclone hedefi) tanımlanmazsa eski yerel yedekler SİLİNMEZ (disk dolabilir): docs/YEDEKLEME.md
# YEDEK_UZAK_HEDEF=uzakadi:klasor
# Eski yerel yedekler ANCAK bu değişken YEDEK_UZAK_HEDEF'in ":" öncesi adıyla BİREBİR aynıysa silinir (örnekte "uzakadi").
# Bu, "bu hedef gerçekten başka bir makinede/bulutta" demektir. Yoksa kopyalanır ve doğrulanır ama HİÇBİR yerel yedek silinmez.
# Özel ağ adresleri (10.x, 172.16-31.x, 192.168.x, 100.64/10, 169.254.x, fc00::/7, fe80::/10) onay olsa bile yerel sayılır.
# Kimlik bilgilerini (parola, anahtar, token) bağlantı dizesine DEĞİL `rclone config` ayar dosyasına yazın ('ps' ile görünür).
# YEDEK_UZAK_ONAYLI_HEDEF=uzakadi
# Geri yükleme sırasında özel anahtarın yolu (varsayılan ./gizli/yedek-anahtari.txt)
# YEDEK_ANAHTAR_DOSYASI=./gizli/yedek-anahtari.txt

# --- Portlar (genellikle değiştirmeyin) ---
HTTP_PORT=80
HTTPS_PORT=443
