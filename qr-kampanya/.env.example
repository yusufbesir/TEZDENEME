# ======================================================================
# QR Kampanya - ortam ayarları ÖRNEĞİ
# Bu dosyayı .env adıyla kopyalayın:  cp .env.example .env
# veya scripts/kurulum.sh betiğini çalıştırın (güçlü parolaları kendisi üretir).
# .env dosyası Git'e EKLENMEZ. Buradaki değerler gerçek değildir.
# ======================================================================

# --- Alan adı (DEĞİŞTİRİN) ---
# QR kodların içine yazılacak alan adınız. Örnek: qr.firmaniz.com
SITE_ALAN_ADI=qr.ornekfirma.com
# Caddy'nin dinleyeceği adres. Üretimde alan adının kendisi (HTTPS otomatik).
# Yerel denemede: http://localhost
SITE_ADRESI=qr.ornekfirma.com
SITE_SEMA=https
DJANGO_ALLOWED_HOSTS=qr.ornekfirma.com
# Let's Encrypt bildirimleri için e-posta (DEĞİŞTİRİN)
ACME_EPOSTA=ornek@ornekfirma.com

# --- Gizli değerler (kurulum.sh üretir; elle yazacaksanız uzun ve rastgele olsun) ---
DJANGO_SECRET_KEY=BURAYA-KURULUM-BETIGI-URETECEK-degistir
POSTGRES_PASSWORD=BURAYA-KURULUM-BETIGI-URETECEK-degistir

# --- Veritabanı ---
POSTGRES_DB=qrkampanya
POSTGRES_USER=qrkampanya

# --- Güvenlik ---
DJANGO_DEBUG=0
MFA_ZORUNLU=1
GIRIS_DENEME_SINIRI=5
GIRIS_KILIT_SURESI_SN=900
# Hesap başına (IP'den bağımsız) geçici kilit eşiği ve IP başına (kullanıcı adından bağımsız) eşik
HESAP_DENEME_SINIRI=10
IP_DENEME_SINIRI=20
# /panel/giris ve /panel/mfa/* için IP başına dakikadaki en çok POST (0 = kapalı)
GIRIS_HIZ_SINIRI=10
YONLENDIRME_HIZ_SINIRI=120

# --- Ağ ---
# Caddy ile uygulamanın bulunduğu "web" ağının alt ağı (gunicorn yalnızca bu ağdan X-Forwarded-* kabul eder).
# Sunucudaki başka bir ağla çakışırsa değiştirin.
WEB_ALT_AGI=172.28.0.0/16

# --- Veri saklama (KVKK) ---
TARAMA_SAKLAMA_GUN=730

# --- Yedekleme ---
YEDEK_SAATI=03:15
YEDEK_SAKLAMA_GUN=14
YEDEK_DIZINI=./yedekler

# --- Portlar (genellikle değiştirmeyin) ---
HTTP_PORT=80
HTTPS_PORT=443
