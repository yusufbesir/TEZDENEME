<?xml version="1.0" encoding="utf-8"?>
<!-- Pırıl: Android 12+ yedekleme/aktarım kurallarının TAMAMI kapalı (uygulama verisi buluta ya da cihaz aktarımına çıkmaz). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
